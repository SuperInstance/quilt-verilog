# SPIN-36 SYNTH arm pw41_never (PW=41, GMODE=0) -- identical flow
# to SPIN-19 synth_gate_*.ice40, PW-parameterized wrapper.
read_verilog -DSYNTHESIS rtl/q_wall_gate.v
read_verilog -DSYNTHESIS cosim/spin36_synth_top.v
chparam -set PW 41 spin36_synth_top
chparam -set GMODE 0 q_wall_gate
hierarchy -check -top spin36_synth_top
synth_ice40 -top spin36_synth_top -json cosim/spin36_pw41_never.json
tee -o cosim/stat36_pw41_never.txt stat -top spin36_synth_top
