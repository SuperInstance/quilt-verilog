import itertools
# primary cells: (pd, delta, alpha, source)
cells = [(3,8,1.247,'spin29'),(3,12,1.172,'spin31'),(4,12,1.096,'spin31'),
         (5,12,1.012,'spin31'),(6,8,0.864,'spin31'),(6,12,0.977,'spin31'),(6,16,1.005,'spin31')]

def ols(pts, vars):
    n=len(vars); k=len(pts)
    import statistics
    # build X, y
    X=[[f(pd,d) for f in vars] for pd,d,a,_ in pts]
    y=[a for _,_,a,_ in pts]
    # normal equations
    m=len(vars)
    A=[[sum(X[r][i]*X[r][j] for r in range(k)) for j in range(m)] for i in range(m)]
    b=[sum(X[r][i]*y[r] for r in range(k)) for i in range(m)]
    # gauss
    for i in range(m):
        p=max(range(i,m),key=lambda r:abs(A[r][i])); A[i],A[p]=A[p],A[i]; b[i],b[p]=b[p],b[i]
        for r in range(i+1,m):
            f=A[r][i]/A[i][i]
            for c in range(i,m): A[r][c]-=f*A[i][c]
            b[r]-=f*b[i]
    coef=[0]*m
    for i in reversed(range(m)):
        coef[i]=(b[i]-sum(A[i][j]*coef[j] for j in range(i+1,m)))/A[i][i]
    resid=[y[r]-sum(coef[j]*X[r][j] for j in range(m)) for r in range(k)]
    return coef, resid

# bilinear on alpha
vars=[lambda p,d:1, lambda p,d:p, lambda p,d:d, lambda p,d:p*d]
coef,res = ols(cells, vars)
print("bilinear alpha ~ 1+pd+d+pd*d (7 cells):")
print("  a=%.4f b=%.4f c=%.4f d=%+.4f  maxres=%.4f"%(coef[0],coef[1],coef[2],coef[3],max(abs(r) for r in res)))
for (p,d,a,s),r in zip(cells,res): print("   (%d,%2d) meas=%.3f fit=%.4f resid=%+.4f [%s]"%(p,d,a,a-r,r,s))

# interior-only (exclude delta==8): 5 cells, 4 params -> 1 dof
ci=[c for c in cells if c[1]!=8]
co2,r2=ols(ci,vars)
print("interior-only (d>=12, 5 cells): d=%+.4f maxres=%.4f"%(co2[3],max(abs(r) for r in r2)))
for (p,d,a,s),r in zip(ci,r2): print("   (%d,%2d) resid=%+.4f"%(p,d,r))

# pd-slopes at each delta (2-point)
print("slope_pd@D8  = %.4f (cross-vintage: uses spin29 1.247)"%((0.864-1.247)/3))
print("slope_pd@D12 = %.4f"%((0.977-1.172)/3))
# implied d
print("implied d = (slope12-slope8)/4 = %+.4f"%((( 0.977-1.172)/3-(0.864-1.247)/3)/4))

# D-gate sensitivity
a8,a12,a16=0.864,0.977,1.005
print("D spread all3 = %.1f%%"% (100*(a16-a8)/((a8+a12+a16)/3)))
print("D spread excl D8 = %.1f%%"%(100*(a16-a12)/((a12+a16)/2)))

# noise floor scaling
for D in (8,12,16):
    print("alpha noise @D=%d (0.5 in C): %.4f ; alpha-quantum (spread step 2): %.4f"%(D,1.6*0.5/(2*D),2*1.6/(2*D)))
# pd=6/D=8 crossing sensitivity: bracket (8,52.5)->(10,44.7), slope 3.9pp/unit
print("pd6 D8: 2pp curve noise -> s* shift %.2f -> C shift %.2f -> alpha shift %.4f"%(2/3.9,1.6*2/3.9,1.6*2/3.9/16))
# extrapolation test pd=7
print("alpha(7) linear pred = %.4f ; saturation pred ~ %.3f"%(1.365-0.067*7, 0.977-0.020))
